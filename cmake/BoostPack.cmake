function(boostpack_add)
  cmake_parse_arguments(BP "" "VERSION" "COMPONENTS" ${ARGN})
  if(BP_UNPARSED_ARGUMENTS OR BP_KEYWORDS_MISSING_VALUES)
    message(FATAL_ERROR "BoostPack: invalid arguments to boostpack_add()")
  endif()
  if(NOT BP_VERSION OR NOT BP_COMPONENTS)
    message(FATAL_ERROR "BoostPack: boostpack_add(VERSION <version> COMPONENTS <names...>) is required")
  endif()

  get_property(previous_version GLOBAL PROPERTY BOOSTPACK_VERSION)
  if(previous_version AND NOT previous_version STREQUAL BP_VERSION)
    message(FATAL_ERROR "BoostPack: Boost ${previous_version} is already loaded; cannot also load ${BP_VERSION}")
  endif()
  if(NOT BP_VERSION STREQUAL "1.92.0")
    message(FATAL_ERROR "BoostPack v0.2.0 only supports Boost 1.92.0 (requested: ${BP_VERSION})")
  endif()

  # Calculate the transitive module closure. Fail before downloading anything
  # if the requested graph contains an unsupported component.
  set(queue ${BP_COMPONENTS})
  set(required "")
  while(queue)
    list(POP_FRONT queue module)
    if(module IN_LIST required)
      continue()
    endif()
    _boostpack_metadata("${module}" deps sha)
    list(APPEND required "${module}")
    list(APPEND queue ${deps})
  endwhile()

  get_property(loaded GLOBAL PROPERTY BOOSTPACK_MODULES)
  set(pending ${required})
  set(ordered "")
  while(pending)
    set(progress FALSE)
    foreach(module IN LISTS pending)
      _boostpack_metadata("${module}" deps sha)
      set(ready TRUE)
      foreach(dep IN LISTS deps)
        if(NOT dep IN_LIST ordered AND NOT dep IN_LIST loaded)
          set(ready FALSE)
          break()
        endif()
      endforeach()
      if(ready)
        list(APPEND ordered "${module}")
        list(REMOVE_ITEM pending "${module}")
        set(progress TRUE)
      endif()
    endforeach()
    if(NOT progress)
      message(FATAL_ERROR "BoostPack: dependency cycle in ${pending}")
    endif()
  endwhile()

  # Reject namespace collisions instead of silently combining incompatible
  # system Boost targets with a source-built subset.
  foreach(module IN LISTS ordered)
    if(TARGET Boost::${module} AND NOT module IN_LIST loaded)
      message(FATAL_ERROR "BoostPack: Boost::${module} already exists outside BoostPack")
    endif()
  endforeach()

  if(BOOSTPACK_CACHE_DIR)
    get_filename_component(cache_dir "${BOOSTPACK_CACHE_DIR}" ABSOLUTE BASE_DIR "${CMAKE_BINARY_DIR}")
    set(FETCHCONTENT_BASE_DIR "${cache_dir}/boost-${BP_VERSION}")
  endif()
  if(BOOSTPACK_OFFLINE)
    set(FETCHCONTENT_FULLY_DISCONNECTED ON)
  endif()
  set(BUILD_TESTING OFF)
  set(BOOST_SUPERPROJECT_VERSION "${BP_VERSION}")

  set(extract_options "")
  if(CMAKE_VERSION VERSION_GREATER_EQUAL 3.24)
    list(APPEND extract_options DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
  endif()

  foreach(module IN LISTS ordered)
    if(module IN_LIST loaded)
      continue()
    endif()
    _boostpack_metadata("${module}" deps sha)
    set(content "boostpack_${module}")
    FetchContent_Declare(${content}
      URL "https://github.com/boostorg/${module}/archive/${sha}.tar.gz"
      SOURCE_SUBDIR "_boostpack_no_autoconfigure"
      ${extract_options}
    )
    FetchContent_MakeAvailable(${content})
    FetchContent_GetProperties(${content} SOURCE_DIR source_dir BINARY_DIR binary_dir)
    if(NOT EXISTS "${source_dir}/CMakeLists.txt")
      message(FATAL_ERROR "BoostPack: source for '${module}' is missing at '${source_dir}'. Disable BOOSTPACK_OFFLINE or populate the cache.")
    endif()
    add_subdirectory("${source_dir}" "${binary_dir}" EXCLUDE_FROM_ALL)
    if(NOT TARGET Boost::${module})
      message(FATAL_ERROR "BoostPack: upstream ${module} did not define Boost::${module}")
    endif()
    list(APPEND loaded "${module}")
    set_property(GLOBAL PROPERTY BOOSTPACK_MODULES "${loaded}")
    message(STATUS "BoostPack: added Boost::${module}")
  endforeach()
  set_property(GLOBAL PROPERTY BOOSTPACK_VERSION "${BP_VERSION}")
endfunction()
