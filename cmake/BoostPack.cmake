# Resolve Boost module sources and their native CMake target dependencies.
# Consumer requirements: CMake 3.22+ and a C++ compiler.

if(CMAKE_VERSION VERSION_LESS 3.22)
  message(FATAL_ERROR "BoostPack requires CMake 3.22 or newer")
endif()

include_guard(GLOBAL)

# BoostPack owns its cache and offline controls; no FetchContent global state.
set(BOOSTPACK_CACHE_DIR "" CACHE PATH "Optional shared Boost archive cache")
option(BOOSTPACK_OFFLINE "Use cached Boost archives only (no network)" OFF)
set(BOOSTPACK_LOCKFILE "" CACHE FILEPATH "Optional JSON lockfile (created when missing)")

# A lockfile pins complete upstream archive bytes, not mutable tag names.
# JSON is parsed as data (never included as executable CMake code).
function(_boostpack_json_string out value)
  string(REPLACE "\\" "\\\\" escaped "${value}")
  string(REPLACE "\"" "\\\"" escaped "${escaped}")
  string(REPLACE "\n" "\\n" escaped "${escaped}")
  string(REPLACE "\r" "\\r" escaped "${escaped}")
  string(REPLACE "\t" "\\t" escaped "${escaped}")
  set(${out} "\"${escaped}\"" PARENT_SCOPE)
endfunction()

function(_boostpack_lock_initialize version repository template)
  if(BOOSTPACK_LOCKFILE)
    get_filename_component(lockfile "${BOOSTPACK_LOCKFILE}" ABSOLUTE
      BASE_DIR "${CMAKE_SOURCE_DIR}")
    if(EXISTS "${lockfile}")
      set(mode READ)
    else()
      if(BOOSTPACK_OFFLINE)
        message(FATAL_ERROR "BoostPack: cannot create lockfile while offline: ${lockfile}")
      endif()
      set(mode WRITE)
    endif()
  else()
    set(lockfile "")
    set(mode "")
  endif()

  get_property(initialized GLOBAL PROPERTY BOOSTPACK_LOCK_INITIALIZED)
  if(initialized)
    get_property(previous_path GLOBAL PROPERTY BOOSTPACK_LOCK_PATH)
    get_property(previous_mode GLOBAL PROPERTY BOOSTPACK_LOCK_MODE_ACTIVE)
    if(NOT previous_path STREQUAL lockfile OR NOT previous_mode STREQUAL mode)
      message(FATAL_ERROR "BoostPack: lockfile settings cannot change during configuration")
    endif()
    return()
  endif()
  set_property(GLOBAL PROPERTY BOOSTPACK_LOCK_INITIALIZED TRUE)
  set_property(GLOBAL PROPERTY BOOSTPACK_LOCK_PATH "${lockfile}")
  set_property(GLOBAL PROPERTY BOOSTPACK_LOCK_MODE_ACTIVE "${mode}")
  if(NOT lockfile)
    return()
  endif()

  if(mode STREQUAL "READ")
    file(READ "${lockfile}" data)
    string(JSON schema_type ERROR_VARIABLE error TYPE "${data}" schema)
    if(NOT error STREQUAL "NOTFOUND" OR NOT schema_type STREQUAL "NUMBER")
      message(FATAL_ERROR "BoostPack: invalid lockfile schema type: ${lockfile}")
    endif()
    string(JSON schema ERROR_VARIABLE error GET "${data}" schema)
    if(NOT error STREQUAL "NOTFOUND" OR NOT schema STREQUAL "1")
      message(FATAL_ERROR "BoostPack: invalid or unsupported lockfile schema: ${lockfile}")
    endif()
    foreach(key IN ITEMS boost_version repository url_template)
      string(JSON value ERROR_VARIABLE error GET "${data}" "${key}")
      if(NOT error STREQUAL "NOTFOUND")
        message(FATAL_ERROR "BoostPack: lockfile missing '${key}': ${lockfile}")
      endif()
      if(key STREQUAL "boost_version")
        set(expected "${version}")
      elseif(key STREQUAL "repository")
        set(expected "${repository}")
      else()
        set(expected "${template}")
      endif()
      if(NOT value STREQUAL expected)
        message(FATAL_ERROR "BoostPack: lockfile ${key} mismatch: expected '${expected}', got '${value}'")
      endif()
    endforeach()
    string(JSON members_type ERROR_VARIABLE error TYPE "${data}" modules)
    if(NOT error STREQUAL "NOTFOUND" OR NOT members_type STREQUAL "OBJECT")
      message(FATAL_ERROR "BoostPack: lockfile 'modules' must be an object")
    endif()
  else()
    # Create a new lock only when none exists, accumulating the complete
    # module closure across multiple boostpack_add() calls.
    set(data "{}")
    string(JSON data SET "${data}" schema 1)
    foreach(key IN ITEMS boost_version repository url_template)
      if(key STREQUAL "boost_version")
        set(value "${version}")
      elseif(key STREQUAL "repository")
        set(value "${repository}")
      else()
        set(value "${template}")
      endif()
      _boostpack_json_string(quoted "${value}")
      string(JSON data SET "${data}" "${key}" "${quoted}")
    endforeach()
    string(JSON data SET "${data}" modules "{}")
  endif()
  set_property(GLOBAL PROPERTY BOOSTPACK_LOCK_DATA "${data}")
  cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}" CALL _boostpack_lock_finish)
endfunction()

# Shared by normal resolution and parallel workers.  Workers only download;
# the parent configure owns lockfile validation and target discovery.
function(_boostpack_expected module url out_expected)
  set(expected "")
  get_property(mode GLOBAL PROPERTY BOOSTPACK_LOCK_MODE_ACTIVE)
  if(mode STREQUAL "READ")
    get_property(data GLOBAL PROPERTY BOOSTPACK_LOCK_DATA)
    string(JSON expected ERROR_VARIABLE error GET "${data}" modules "${module}" sha256)
    if(NOT error STREQUAL "NOTFOUND")
      message(FATAL_ERROR "BoostPack: module '${module}' is missing from the lockfile")
    endif()
    string(LENGTH "${expected}" length)
    if(NOT length EQUAL 64 OR expected MATCHES "[^0-9a-fA-F]")
      message(FATAL_ERROR "BoostPack: invalid SHA256 for '${module}' in lockfile")
    endif()
    string(JSON locked_url ERROR_VARIABLE error GET "${data}" modules "${module}" url)
    if(NOT error STREQUAL "NOTFOUND" OR NOT locked_url STREQUAL url)
      message(FATAL_ERROR "BoostPack: lockfile URL mismatch for '${module}' (expected '${url}')")
    endif()
  endif()
  set(${out_expected} "${expected}" PARENT_SCOPE)
endfunction()

function(_boostpack_download module url archive expected)
  if(NOT url MATCHES "^(https://|file://)")
    _boostpack_download_abort("BoostPack: archive URL must use HTTPS or file://: ${url}")
  endif()
  if(EXISTS "${archive}")
    return()
  endif()
  get_filename_component(archive_dir "${archive}" DIRECTORY)
  file(MAKE_DIRECTORY "${archive_dir}")
  file(LOCK "${archive}.lock" GUARD FUNCTION TIMEOUT 120 RESULT_VARIABLE lock_result)
  if(NOT lock_result STREQUAL "0")
    _boostpack_download_abort("BoostPack: cannot lock cached archive for '${module}': ${lock_result}")
  endif()
  if(EXISTS "${archive}")
    return()
  endif()
  if(BOOSTPACK_OFFLINE)
    _boostpack_download_abort("BoostPack: offline cache is missing the archive for '${module}': ${archive}")
  endif()

  # Skip GitHub's archive redirect without changing the canonical lockfile URL.
  set(download_url "${url}")
  if(url MATCHES "^https://github[.]com/boostorg/([a-z0-9_]+)/archive/refs/tags/(boost-[0-9]+[.][0-9]+[.][0-9]+)[.]tar[.]gz$")
    set(download_url "https://codeload.github.com/boostorg/${CMAKE_MATCH_1}/tar.gz/refs/tags/${CMAKE_MATCH_2}")
  endif()
  message(STATUS "BoostPack: downloading ${module}")
  file(DOWNLOAD "${download_url}" "${archive}.partial"
    STATUS status LOG log TLS_VERIFY ON TIMEOUT 300 INACTIVITY_TIMEOUT 60)
  list(GET status 0 code)
  list(GET status 1 detail)
  if(NOT code EQUAL 0)
    file(REMOVE "${archive}.partial")
    _boostpack_download_abort("BoostPack: failed to download '${module}' from '${url}': ${detail}\n${log}")
  endif()
  if(expected)
    file(SHA256 "${archive}.partial" downloaded_sha)
    if(NOT downloaded_sha STREQUAL expected)
      file(REMOVE "${archive}.partial")
      _boostpack_download_abort("BoostPack: SHA256 mismatch for downloaded '${module}' from '${url}'")
    endif()
  endif()
  file(RENAME "${archive}.partial" "${archive}")
endfunction()

function(_boostpack_archive module url out_archive out_sha)
  _boostpack_expected("${module}" "${url}" expected)
  set(archive "${_BOOSTPACK_ARCHIVE_CACHE}/${module}.tar.gz")
  _boostpack_download("${module}" "${url}" "${archive}" "${expected}")
  file(SHA256 "${archive}" actual_sha)
  get_property(mode GLOBAL PROPERTY BOOSTPACK_LOCK_MODE_ACTIVE)
  if(mode STREQUAL "READ" AND NOT actual_sha STREQUAL expected)
    message(FATAL_ERROR "BoostPack: SHA256 mismatch for cached '${module}': ${archive}")
  endif()

  if(mode STREQUAL "WRITE")
    get_property(data GLOBAL PROPERTY BOOSTPACK_LOCK_DATA)
    _boostpack_json_string(url_json "${url}")
    _boostpack_json_string(sha_json "${actual_sha}")
    set(record "{}")
    string(JSON record SET "${record}" sha256 "${sha_json}")
    string(JSON record SET "${record}" url "${url_json}")
    string(JSON data SET "${data}" modules "${module}" "${record}")
    set_property(GLOBAL PROPERTY BOOSTPACK_LOCK_DATA "${data}")
  endif()
  set(${out_archive} "${archive}" PARENT_SCOPE)
  set(${out_sha} "${actual_sha}" PARENT_SCOPE)
endfunction()

function(_boostpack_lock_finish)
  get_property(mode GLOBAL PROPERTY BOOSTPACK_LOCK_MODE_ACTIVE)
  get_property(lockfile GLOBAL PROPERTY BOOSTPACK_LOCK_PATH)
  get_property(data GLOBAL PROPERTY BOOSTPACK_LOCK_DATA)
  if(mode STREQUAL "READ")
    string(JSON count LENGTH "${data}" modules)
    get_property(resolved GLOBAL PROPERTY BOOSTPACK_MODULES)
    list(LENGTH resolved resolved_count)
    get_property(support GLOBAL PROPERTY BOOSTPACK_SUPPORT_SOURCE)
    if(support)
      math(EXPR resolved_count "${resolved_count}+1")
    endif()
    if(NOT count EQUAL resolved_count)
      message(FATAL_ERROR
        "BoostPack: lockfile dependency closure mismatch: ${count} entries, "
        "${resolved_count} configured archives")
    endif()
  elseif(mode STREQUAL "WRITE")
    get_filename_component(dir "${lockfile}" DIRECTORY)
    file(MAKE_DIRECTORY "${dir}")
    file(LOCK "${lockfile}.lock" GUARD FUNCTION TIMEOUT 120 RESULT_VARIABLE lock_result)
    if(NOT lock_result STREQUAL "0")
      message(FATAL_ERROR "BoostPack: cannot lock lockfile '${lockfile}': ${lock_result}")
    endif()
    if(EXISTS "${lockfile}")
      message(FATAL_ERROR "BoostPack: lockfile created by another configure; reconfigure to verify it")
    endif()
    file(WRITE "${lockfile}.tmp" "${data}\n")
    file(RENAME "${lockfile}.tmp" "${lockfile}")
    message(STATUS "BoostPack: wrote lockfile ${lockfile}")
  endif()
endfunction()

# Extract archives independently without touching the host's FetchContent.
function(_boostpack_module_url module version repository template out_url)
  set(url "${template}")
  string(REPLACE "@REPOSITORY@" "${repository}" url "${url}")
  string(REPLACE "@MODULE@" "${module}" url "${url}")
  string(REPLACE "@VERSION@" "${version}" url "${url}")
  string(REPLACE "@TAG@" "boost-${version}" url "${url}")
  set(${out_url} "${url}" PARENT_SCOPE)
endfunction()


# The standalone file is also the worker entry point; no generated scripts or
# job argument files. One ephemeral status file per in-flight archive is enough.
function(_boostpack_worker_result result)
  if(DEFINED _BOOSTPACK_WORKER_STATUS)
    file(WRITE "${_BOOSTPACK_WORKER_STATUS}.partial" "${result}\n")
    file(RENAME "${_BOOSTPACK_WORKER_STATUS}.partial" "${_BOOSTPACK_WORKER_STATUS}")
  endif()
endfunction()

function(_boostpack_download_abort reason)
  _boostpack_worker_result("ERROR: ${reason}")
  message(FATAL_ERROR "${reason}")
endfunction()

function(_boostpack_shell_quote out value)
  string(REPLACE "'" "'\\''" quoted "${value}")
  set(${out} "'${quoted}'" PARENT_SCOPE)
endfunction()

function(_boostpack_ps_quote out value)
  string(REPLACE "'" "''" quoted "${value}")
  set(${out} "'${quoted}'" PARENT_SCOPE)
endfunction()

function(_boostpack_start_download module version repository template)
  _boostpack_module_url("${module}" "${version}" "${repository}" "${template}" url)
  _boostpack_expected("${module}" "${url}" expected)
  set(status "${CMAKE_BINARY_DIR}/_boostpack/download-jobs/${module}.status")
  get_filename_component(dir "${status}" DIRECTORY)
  file(MAKE_DIRECTORY "${dir}")
  file(WRITE "${status}" "RUNNING\n")

  set(args
    "-D_BOOSTPACK_WORKER_MODULE=${module}"
    "-D_BOOSTPACK_WORKER_URL=${url}"
    "-D_BOOSTPACK_WORKER_ARCHIVE=${_BOOSTPACK_ARCHIVE_CACHE}/${module}.tar.gz"
    "-D_BOOSTPACK_WORKER_EXPECTED=${expected}"
    "-D_BOOSTPACK_WORKER_STATUS=${status}"
    "-P" "${CMAKE_CURRENT_FUNCTION_LIST_FILE}")

  if(WIN32)
    _boostpack_ps_quote(cmake_arg "${CMAKE_COMMAND}")
    set(ps_args "")
    foreach(arg IN LISTS args)
      # Start-Process joins arguments as a Windows command line; embedded
      # double quotes keep paths with spaces intact.
      _boostpack_ps_quote(escaped "\"${arg}\"")
      list(APPEND ps_args "${escaped}")
    endforeach()
    string(JOIN ", " ps_args ${ps_args})
    execute_process(COMMAND powershell.exe -NoProfile -NonInteractive -Command
      "$ErrorActionPreference='Stop'; Start-Process -FilePath ${cmake_arg} -ArgumentList @(${ps_args}) -WindowStyle Hidden"
      RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
  else()
    _boostpack_shell_quote(cmake_arg "${CMAKE_COMMAND}")
    set(command "${cmake_arg}")
    foreach(arg IN LISTS args)
      _boostpack_shell_quote(escaped "${arg}")
      string(APPEND command " ${escaped}")
    endforeach()
    execute_process(COMMAND /bin/sh -c
      "${command} </dev/null >/dev/null 2>&1 &"
      RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
  endif()
  if(NOT result STREQUAL "0")
    message(FATAL_ERROR
      "BoostPack: failed starting download of '${module}': ${error}\n${output}")
  endif()
  message(STATUS "BoostPack: started download of ${module}")
endfunction()

function(_boostpack_reap_downloads active out_active)
  set(remaining "")
  foreach(module IN LISTS active)
    set(status "${CMAKE_BINARY_DIR}/_boostpack/download-jobs/${module}.status")
    if(NOT EXISTS "${status}")
      message(FATAL_ERROR "BoostPack: worker status missing for '${module}'")
    endif()
    file(READ "${status}" result)
    string(STRIP "${result}" result)
    if(result STREQUAL "RUNNING")
      list(APPEND remaining "${module}")
    elseif(result STREQUAL "OK")
      if(NOT EXISTS "${_BOOSTPACK_ARCHIVE_CACHE}/${module}.tar.gz")
        message(FATAL_ERROR "BoostPack: download of '${module}' finished without an archive")
      endif()
      file(REMOVE "${status}")
    else()
      message(FATAL_ERROR "BoostPack: download of '${module}' failed:\n${result}")
    endif()
  endforeach()
  set(${out_active} "${remaining}" PARENT_SCOPE)
endfunction()

function(_boostpack_fetch module version repository template out_source out_binary)
  _boostpack_module_url("${module}" "${version}" "${repository}" "${template}" url)

  _boostpack_archive("${module}" "${url}" archive sha)
  string(SUBSTRING "${sha}" 0 24 short_sha)

  set(extract_dir "${CMAKE_BINARY_DIR}/_boostpack/sources/${module}/${short_sha}")
  # A directory keyed by the archive SHA becomes visible only after
  # extraction has completed and the temporary tree is renamed into place.
  # No redundant ready marker or extraction-only lock file is necessary.
  if(EXISTS "${extract_dir}")
    # A cached extraction with its root CMake file removed is incomplete.
    # Keep validation structural: a marker cannot prove file integrity.
    file(GLOB roots "${extract_dir}/CMakeLists.txt"
      "${extract_dir}/*/CMakeLists.txt"
      "${extract_dir}/include/BoostInstall.cmake"
      "${extract_dir}/*/include/BoostInstall.cmake")
    if(NOT roots)
      file(REMOVE_RECURSE "${extract_dir}")
    endif()
  endif()
  if(NOT EXISTS "${extract_dir}")
    file(REMOVE_RECURSE "${extract_dir}.partial")
    file(MAKE_DIRECTORY "${extract_dir}.partial")
    file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${extract_dir}.partial")
    file(RENAME "${extract_dir}.partial" "${extract_dir}")
  endif()

  if(EXISTS "${extract_dir}/CMakeLists.txt"
      OR EXISTS "${extract_dir}/include/BoostInstall.cmake")
    set(source_dir "${extract_dir}")
  else()
    file(GLOB entries LIST_DIRECTORIES TRUE "${extract_dir}/*")
    set(roots "")
    foreach(entry IN LISTS entries)
      if(IS_DIRECTORY "${entry}" AND
          (EXISTS "${entry}/CMakeLists.txt"
           OR EXISTS "${entry}/include/BoostInstall.cmake"))
        list(APPEND roots "${entry}")
      endif()
    endforeach()
    list(LENGTH roots count)
    if(NOT count EQUAL 1)
      message(FATAL_ERROR
        "BoostPack: archive for '${module}' must contain one Boost module root")
    endif()
    list(GET roots 0 source_dir)
  endif()
  set(binary_dir "${CMAKE_BINARY_DIR}/_boostpack/binary/${module}/${short_sha}")
  message(STATUS "BoostPack: resolving ${module} from Boost ${version}")
  set(${out_source} "${source_dir}" PARENT_SCOPE)
  set(${out_binary} "${binary_dir}" PARENT_SCOPE)
endfunction()

# Some upstream projects call boost_install() (and related helpers) when
# BOOST_SUPERPROJECT_VERSION is set. Obtain the version-matched official
# boostorg/cmake support only when a module actually references it.
function(_boostpack_needs_support source_dir out_needed)
  # Helpers can be used by includes and nested CMakeLists.txt files.
  file(GLOB_RECURSE scripts LIST_DIRECTORIES FALSE
    "${source_dir}/CMakeLists.txt" "${source_dir}/*/CMakeLists.txt"
    "${source_dir}/*.cmake")
  foreach(script IN LISTS scripts)
    # Tests are disabled, and should not cause extra archive downloads.
    file(RELATIVE_PATH relative "${source_dir}" "${script}")
    if(relative MATCHES "^(test|tests)/|/(test|tests)/")
      continue()
    endif()
    file(READ "${script}" contents)
    if(contents MATCHES "boost_install[ \t\r\n]*\\("
        OR contents MATCHES "boost_message[ \t\r\n]*\\("
        OR contents MATCHES "include[ \t\r\n]*\\([ \t]*Boost(Install|Message|Root|Test)")
      set(${out_needed} TRUE PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${out_needed} FALSE PARENT_SCOPE)
endfunction()

# CMake resolves namespaced link dependencies during generation, after all
# add_subdirectory() calls. Inspect the actual configured target graph, so
# included files, functions, variables and platform conditions are respected.
function(_boostpack_targets directory out_targets)
  get_property(targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
  get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
  foreach(child IN LISTS children)
    _boostpack_targets("${child}" nested)
    list(APPEND targets ${nested})
  endforeach()
  set(${out_targets} "${targets}" PARENT_SCOPE)
endfunction()

# Inspect the target graph at configure time; CMake evaluates link generator
# expressions only during generation, after dependencies must be available.
function(_boostpack_expand_links_config out links configuration)
  set(value "${links}")
  set(unsupported_count 0)
  while(value MATCHES "\\$<")
    string(REGEX MATCH "\\$<[^<>]*>" chunk "${value}")
    if(NOT chunk)
      message(FATAL_ERROR "BoostPack: malformed generator expression in '${links}'")
    endif()
    string(LENGTH "${chunk}" n)
    math(EXPR n "${n}-3")
    string(SUBSTRING "${chunk}" 2 ${n} expression)
    string(FIND "${expression}" ":" split)
    if(split LESS 0)
      set(op "${expression}")
      set(args "")
    else()
      string(SUBSTRING "${expression}" 0 ${split} op)
      math(EXPR start "${split}+1")
      string(SUBSTRING "${expression}" ${start} -1 args)
    endif()

    set(replacement "")
    set(unsupported FALSE)
    if(op MATCHES "^(BUILD_INTERFACE|LINK_ONLY|GENEX_EVAL|1)$")
      set(replacement "${args}")
    elseif(op MATCHES "^(INSTALL_INTERFACE|TARGET_NAME_IF_EXISTS|0)$")
      # These expressions do not request another module.
    elseif(op STREQUAL "IF")
      if(NOT "${args}" MATCHES "^([^,]*),([^,]*),(.*)$")
        message(FATAL_ERROR "BoostPack: malformed IF '${chunk}'")
      endif()
      set(cond "${CMAKE_MATCH_1}")
      set(yes "${CMAKE_MATCH_2}")
      set(no "${CMAKE_MATCH_3}")
      if(cond STREQUAL "1")
        set(replacement "${yes}")
      elseif(cond STREQUAL "0")
        set(replacement "${no}")
      elseif(cond MATCHES "__BOOSTPACK_UNSUPPORTED_[0-9]+__")
        set(replacement "${cond}")
      else()
        message(FATAL_ERROR "BoostPack: invalid IF condition in '${chunk}'")
      endif()
    elseif(op STREQUAL "BOOL")
      if(args MATCHES "__BOOSTPACK_UNSUPPORTED_[0-9]+__")
        set(replacement "${args}")
      elseif("${args}")
        set(replacement 1)
      else()
        set(replacement 0)
      endif()
    elseif(op STREQUAL "NOT")
      if(args MATCHES "__BOOSTPACK_UNSUPPORTED_[0-9]+__")
        set(replacement "${args}")
      elseif(args STREQUAL "0")
        set(replacement 1)
      elseif(args STREQUAL "1")
        set(replacement 0)
      else()
        message(FATAL_ERROR "BoostPack: invalid NOT argument in '${chunk}'")
      endif()
    elseif(op STREQUAL "AND" OR op STREQUAL "OR")
      string(REPLACE "," ";" conditions "${args}")
      set(unknown "")
      if(op STREQUAL "AND")
        set(replacement 1)
        set(decisive 0)
      else()
        set(replacement 0)
        set(decisive 1)
      endif()
      foreach(cond IN LISTS conditions)
        if("${cond}" STREQUAL "${decisive}")
          set(replacement "${decisive}")
          set(unknown "")
          break()
        elseif(cond MATCHES "__BOOSTPACK_UNSUPPORTED_[0-9]+__")
          set(unknown "${cond}")
        elseif(NOT cond MATCHES "^[01]$")
          message(FATAL_ERROR "BoostPack: invalid ${op} argument in '${chunk}'")
        endif()
      endforeach()
      if(unknown)
        set(replacement "${unknown}")
      endif()
    elseif(op MATCHES "^(CONFIG|PLATFORM_ID|CXX_COMPILER_ID)$")
      if(op STREQUAL "CONFIG")
        string(TOUPPER "${configuration}" active)
        string(TOUPPER "${args}" names)
      elseif(op STREQUAL "PLATFORM_ID")
        set(active "${CMAKE_SYSTEM_NAME}")
        set(names "${args}")
      else()
        set(active "${CMAKE_CXX_COMPILER_ID}")
        set(names "${args}")
      endif()
      string(REPLACE "," ";" names "${names}")
      list(FIND names "${active}" index)
      if(index EQUAL -1)
        set(replacement 0)
      else()
        set(replacement 1)
      endif()
    elseif(op STREQUAL "STREQUAL" OR op STREQUAL "EQUAL")
      if(NOT "${args}" MATCHES "^([^,]*),(.*)$")
        message(FATAL_ERROR "BoostPack: malformed comparison '${chunk}'")
      endif()
      set(lhs "${CMAKE_MATCH_1}")
      set(rhs "${CMAKE_MATCH_2}")
      if(lhs MATCHES "__BOOSTPACK_UNSUPPORTED_[0-9]+__"
          OR rhs MATCHES "__BOOSTPACK_UNSUPPORTED_[0-9]+__")
        set(replacement "${args}")
      elseif((op STREQUAL "STREQUAL" AND lhs STREQUAL rhs)
          OR (op STREQUAL "EQUAL" AND lhs EQUAL rhs))
        set(replacement 1)
      else()
        set(replacement 0)
      endif()
    elseif(op STREQUAL "TARGET_EXISTS")
      if(args MATCHES "__BOOSTPACK_UNSUPPORTED_[0-9]+__")
        set(replacement "${args}")
      elseif(TARGET "${args}")
        set(replacement 1)
      elseif(args MATCHES "^Boost::")
        # This target may be added by a later module download.
        set(unsupported TRUE)
      else()
        set(replacement 0)
      endif()
    elseif(op STREQUAL "LINK_LIBRARY" OR op STREQUAL "LINK_GROUP")
      if(NOT "${args}" MATCHES "^[^,]*,(.*)$")
        message(FATAL_ERROR "BoostPack: malformed link wrapper '${chunk}'")
      endif()
      set(replacement "${CMAKE_MATCH_1}")
    else()
      # Reject unknown expressions only if their enclosing branch is active.
      set(unsupported TRUE)
    endif()
    if(unsupported)
      math(EXPR unsupported_count "${unsupported_count}+1")
      set("unsupported_${unsupported_count}" "${chunk}")
      set(replacement "__BOOSTPACK_UNSUPPORTED_${unsupported_count}__")
    endif()
    string(REPLACE "${chunk}" "${replacement}" value "${value}")
  endwhile()
  if(value MATCHES "__BOOSTPACK_UNSUPPORTED_([0-9]+)__")
    set(index "${CMAKE_MATCH_1}")
    message(FATAL_ERROR
      "BoostPack: unsupported link generator expression '${unsupported_${index}}'")
  endif()
  set(${out} "${value}" PARENT_SCOPE)
endfunction()

function(_boostpack_expand_links out links)
  if(CMAKE_CONFIGURATION_TYPES)
    set(configurations ${CMAKE_CONFIGURATION_TYPES})
  elseif(CMAKE_BUILD_TYPE)
    set(configurations "${CMAKE_BUILD_TYPE}")
  else()
    set(configurations "__boostpack_no_build_type__")
  endif()
  set(expanded_all "")
  foreach(configuration IN LISTS configurations)
    _boostpack_expand_links_config(expanded "${links}" "${configuration}")
    list(APPEND expanded_all ${expanded})
  endforeach()
  list(REMOVE_DUPLICATES expanded_all)
  set(${out} "${expanded_all}" PARENT_SCOPE)
endfunction()

function(_boostpack_dependencies module source_dir out_deps)
  _boostpack_targets("${source_dir}" targets)
  set(deps "")
  foreach(target IN LISTS targets)
    foreach(prop IN ITEMS LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
      get_target_property(links "${target}" "${prop}")
      if(NOT links)
        continue()
      endif()
      _boostpack_expand_links(expanded "${links}")
      string(REGEX MATCHALL "Boost::[A-Za-z][A-Za-z0-9_]*" references "${expanded}")
      foreach(reference IN LISTS references)
        string(SUBSTRING "${reference}" 7 -1 dep)
        # A module may export additional targets (Boost::asio_spawn, etc.).
        if(dep STREQUAL module OR dep MATCHES "^${module}_")
          continue()
        endif()
        list(APPEND deps "${dep}")
      endforeach()
    endforeach()
  endforeach()
  list(REMOVE_DUPLICATES deps)
  list(SORT deps)
  set(${out_deps} "${deps}" PARENT_SCOPE)
endfunction()

function(boostpack_add)
  cmake_parse_arguments(BP "" "VERSION;REPOSITORY;URL_TEMPLATE" "COMPONENTS" ${ARGN})
  if(BP_UNPARSED_ARGUMENTS OR BP_KEYWORDS_MISSING_VALUES)
    message(FATAL_ERROR "BoostPack: invalid arguments to boostpack_add()")
  endif()
  if(NOT BP_VERSION OR NOT BP_COMPONENTS)
    message(FATAL_ERROR "BoostPack: boostpack_add(VERSION <version> COMPONENTS <modules...>) is required")
  endif()
  if(NOT BP_VERSION MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+$")
    message(FATAL_ERROR "BoostPack: expected a Boost release version such as 1.92.0, got '${BP_VERSION}'")
  endif()
  foreach(module IN LISTS BP_COMPONENTS)
    if(NOT module MATCHES "^[a-z][a-z0-9_]*$")
      message(FATAL_ERROR "BoostPack: invalid Boost module name '${module}'")
    endif()
  endforeach()

  if(BP_REPOSITORY)
    set(repository "${BP_REPOSITORY}")
  else()
    set(repository "https://github.com/boostorg")
  endif()
  string(REGEX REPLACE "/+$" "" repository "${repository}")
  if(NOT repository)
    message(FATAL_ERROR "BoostPack: REPOSITORY must not be empty")
  endif()
  if(BP_URL_TEMPLATE)
    set(template "${BP_URL_TEMPLATE}")
  else()
    set(template "@REPOSITORY@/@MODULE@/archive/refs/tags/@TAG@.tar.gz")
  endif()
  if(NOT template MATCHES "@MODULE@" OR NOT template MATCHES "@TAG@|@VERSION@")
    message(FATAL_ERROR "BoostPack: URL_TEMPLATE must include @MODULE@ and @TAG@ or @VERSION@")
  endif()

  get_property(loaded_version GLOBAL PROPERTY BOOSTPACK_VERSION)
  get_property(loaded_repository GLOBAL PROPERTY BOOSTPACK_REPOSITORY)
  get_property(loaded_template GLOBAL PROPERTY BOOSTPACK_URL_TEMPLATE)
  if(loaded_version AND NOT loaded_version STREQUAL BP_VERSION)
    message(FATAL_ERROR "BoostPack: Boost ${loaded_version} is already loaded; cannot also load ${BP_VERSION}")
  endif()
  if(loaded_repository AND NOT loaded_repository STREQUAL repository)
    message(FATAL_ERROR "BoostPack: repository cannot change in the same CMake configure")
  endif()
  if(loaded_template AND NOT loaded_template STREQUAL template)
    message(FATAL_ERROR "BoostPack: URL_TEMPLATE cannot change in the same CMake configure")
  endif()

  string(SHA256 repository_hash "${repository}\n${template}")
  string(SUBSTRING "${repository_hash}" 0 12 cache_key)
  if(BOOSTPACK_CACHE_DIR)
    get_filename_component(cache_root "${BOOSTPACK_CACHE_DIR}" ABSOLUTE
      BASE_DIR "${CMAKE_BINARY_DIR}")
    set(_BOOSTPACK_ARCHIVE_CACHE "${cache_root}/boost-${BP_VERSION}/${cache_key}/archives")
  else()
    set(_BOOSTPACK_ARCHIVE_CACHE
      "${CMAKE_BINARY_DIR}/_boostpack/archives/boost-${BP_VERSION}/${cache_key}")
  endif()
  _boostpack_lock_initialize("${BP_VERSION}" "${repository}" "${template}")

  # Upstream Boost projects should not install into the consumer or enable
  # their own test suites. These variables remain local to this function.
  set(BUILD_TESTING OFF)
  set(BOOST_SKIP_INSTALL_RULES ON)
  set(BOOST_SUPERPROJECT_VERSION "${BP_VERSION}")

  get_property(loaded GLOBAL PROPERTY BOOSTPACK_MODULES)
  get_property(support_dir GLOBAL PROPERTY BOOSTPACK_SUPPORT_SOURCE)
  if(support_dir)
    list(PREPEND CMAKE_MODULE_PATH "${support_dir}/include")
  endif()

  # Resolve targets in the caller's context, but keep independent downloads
  # flowing. Every configured module can enqueue its dependencies immediately.
  set(queue ${BP_COMPONENTS})
  set(inflight "")
  string(TIMESTAMP last_progress "%s" UTC)
  while(queue OR inflight)
    list(REMOVE_DUPLICATES queue)
    list(LENGTH inflight prior)
    _boostpack_reap_downloads("${inflight}" inflight)
    list(LENGTH inflight current)
    set(progress FALSE)
    if(current LESS prior)
      set(progress TRUE)
    endif()
    list(LENGTH queue count)
    if(count EQUAL 1 AND NOT inflight)
      set(single TRUE)
    else()
      set(single FALSE)
    endif()

    # Refill free slots as soon as target inspection discovers new modules.
    if(NOT BOOSTPACK_OFFLINE AND NOT single)
      foreach(candidate IN LISTS queue)
        if(candidate IN_LIST loaded OR candidate IN_LIST inflight
            OR EXISTS "${_BOOSTPACK_ARCHIVE_CACHE}/${candidate}.tar.gz")
          continue()
        endif()
        if(TARGET Boost::${candidate})
          message(FATAL_ERROR "BoostPack: Boost::${candidate} already exists outside BoostPack")
        endif()
        list(LENGTH inflight active_count)
        if(active_count GREATER_EQUAL 8)
          break()
        endif()
        _boostpack_start_download("${candidate}" "${BP_VERSION}" "${repository}" "${template}")
        list(APPEND inflight "${candidate}")
        set(progress TRUE)
      endforeach()
    endif()

    # Configure the first available package without waiting for all peers.
    set(module "")
    foreach(candidate IN LISTS queue)
      if(candidate IN_LIST loaded
          OR EXISTS "${_BOOSTPACK_ARCHIVE_CACHE}/${candidate}.tar.gz"
          OR BOOSTPACK_OFFLINE)
        set(module "${candidate}")
        break()
      endif()
    endforeach()
    if(NOT module AND single)
      list(GET queue 0 module)
    endif()
    if(module)
      list(REMOVE_ITEM queue "${module}")
      if(NOT module IN_LIST loaded)
        if(TARGET Boost::${module})
          message(FATAL_ERROR "BoostPack: Boost::${module} already exists outside BoostPack")
        endif()
        _boostpack_fetch("${module}" "${BP_VERSION}" "${repository}" "${template}"
          source_dir binary_dir)
        if(NOT EXISTS "${source_dir}/CMakeLists.txt")
          message(FATAL_ERROR
            "BoostPack: '${module}' has no CMakeLists.txt at '${source_dir}'. "
            "Verify that Boost ${BP_VERSION} contains the module and that the "
            "mirror/cache is populated (offline=${BOOSTPACK_OFFLINE}).")
        endif()
        _boostpack_needs_support("${source_dir}" needs_support)
        if(needs_support)
          if(NOT support_dir)
            _boostpack_fetch("cmake" "${BP_VERSION}" "${repository}" "${template}"
              support_dir support_binary)
            if(NOT EXISTS "${support_dir}/include/BoostInstall.cmake")
              message(FATAL_ERROR
                "BoostPack: missing upstream CMake support for Boost ${BP_VERSION} "
                "at '${support_dir}/include/BoostInstall.cmake'")
            endif()
            set_property(GLOBAL PROPERTY BOOSTPACK_SUPPORT_SOURCE "${support_dir}")
            list(PREPEND CMAKE_MODULE_PATH "${support_dir}/include")
          endif()
          include(BoostInstall)
        endif()
        add_subdirectory("${source_dir}" "${binary_dir}" EXCLUDE_FROM_ALL)
        if(NOT TARGET Boost::${module})
          message(FATAL_ERROR
            "BoostPack: '${module}' did not define Boost::${module} "
            "for Boost ${BP_VERSION}; check upstream CMake support")
        endif()
        _boostpack_dependencies("${module}" "${source_dir}" deps)
        list(APPEND loaded "${module}")
        set_property(GLOBAL PROPERTY BOOSTPACK_MODULES "${loaded}")
        message(STATUS "BoostPack: added Boost::${module}")
        list(APPEND queue ${deps})
      endif()
      set(progress TRUE)
    endif()

    if(progress)
      string(TIMESTAMP last_progress "%s" UTC)
    elseif(inflight)
      string(TIMESTAMP now "%s" UTC)
      math(EXPR idle "${now}-${last_progress}")
      if(idle GREATER 420)
        message(FATAL_ERROR "BoostPack: timed out waiting for downloads: ${inflight}")
      endif()
      execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 0.2)
    elseif(queue)
      message(FATAL_ERROR "BoostPack: resolver stalled on '${queue}'")
    endif()
  endwhile()
  if(EXISTS "${CMAKE_BINARY_DIR}/_boostpack/download-jobs")
    file(REMOVE_RECURSE "${CMAKE_BINARY_DIR}/_boostpack/download-jobs")
  endif()

  set_property(GLOBAL PROPERTY BOOSTPACK_VERSION "${BP_VERSION}")
  set_property(GLOBAL PROPERTY BOOSTPACK_REPOSITORY "${repository}")
  set_property(GLOBAL PROPERTY BOOSTPACK_URL_TEMPLATE "${template}")
endfunction()

# CMake -P executes the same standalone file in worker mode. A status update
# is the final operation, after _boostpack_download has atomically published
# its archive. Failed downloads publish their diagnostic before aborting.
if(DEFINED _BOOSTPACK_WORKER_MODULE)
  _boostpack_download("${_BOOSTPACK_WORKER_MODULE}" "${_BOOSTPACK_WORKER_URL}"
    "${_BOOSTPACK_WORKER_ARCHIVE}" "${_BOOSTPACK_WORKER_EXPECTED}")
  _boostpack_worker_result("OK")
endif()
