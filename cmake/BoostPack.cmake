# Configure Boost modules from immutable upstream revisions, without a Boost
# installation or a separate dependency manager. Requires CMake 3.22+.

if(CMAKE_VERSION VERSION_LESS 3.22)
  message(FATAL_ERROR "BoostPack requires CMake 3.22 or newer")
endif()

include_guard(GLOBAL)
include(FetchContent)

set(BOOSTPACK_CACHE_DIR "" CACHE PATH "Optional shared directory for fetched Boost modules")
option(BOOSTPACK_OFFLINE "Use only already-populated Boost module sources" OFF)

# Release-specific metadata. Direct dependencies come from the upstream
# boost-1.92.0 CMakeLists.txt files; revisions are the corresponding Git tags'
# resolved commit SHAs. Consumers never execute boostdep or download metadata.
function(_boostpack_metadata module out_deps out_sha)
  set(_bp_deps_assert config)
  set(_bp_deps_charconv assert config core)
  set(_bp_deps_config "")
  set(_bp_deps_container assert config intrusive move)
  set(_bp_deps_container_hash config describe mp11)
  set(_bp_deps_core assert config throw_exception)
  set(_bp_deps_describe mp11)
  set(_bp_deps_dynamic_bitset assert config container_hash core throw_exception)
  set(_bp_deps_endian config)
  set(_bp_deps_intrusive assert config move)
  set(_bp_deps_io config)
  set(_bp_deps_move config)
  set(_bp_deps_mp11 "")
  set(_bp_deps_pfr "")
  set(_bp_deps_predef "")
  set(_bp_deps_preprocessor "")
  set(_bp_deps_scope config core type_traits)
  set(_bp_deps_static_string assert container_hash core throw_exception utility)
  set(_bp_deps_throw_exception assert config)
  set(_bp_deps_type_traits config)
  set(_bp_deps_unordered assert config container_hash core mp11 predef throw_exception)
  set(_bp_deps_utility config core io preprocessor throw_exception type_traits)
  set(_bp_deps_uuid assert config throw_exception type_traits)

  set(_bp_sha_assert  fc2a476cc7d9f42b65ec104e90d24bfd6290efdc)
  set(_bp_sha_charconv 4475d6550fafc6dca45b333dccaf45d96d1cb196)
  set(_bp_sha_config 115e718e0fd72329e69fc776dac99811385d6f77)
  set(_bp_sha_container f74270de43714edccf17b33eca454348d47402b7)
  set(_bp_sha_container_hash 2698b43803c012601e6bb1a6116e83767b97986c)
  set(_bp_sha_core a90a31934fe8bcb6e6be6dfea77b80492c7b6c81)
  set(_bp_sha_describe 5e7b4b84c8d105093687b940a45ac22df47b1ab4)
  set(_bp_sha_dynamic_bitset b2c17416ea930e8b6b8eb6f891970a3fd29bd134)
  set(_bp_sha_endian 4bffdf3defc2836409e72622066a40d8396088ae)
  set(_bp_sha_intrusive b089da5af88981d6e87392680b0b68fd30be0b12)
  set(_bp_sha_io 342e4c6d10d586058818daa84201a2d301357a53)
  set(_bp_sha_move b1ecb39a75ed2de17c23c46a005ac79f59a528ca)
  set(_bp_sha_mp11 c3eba6ac6be2e21af33a1b2ec97634cd01bcc447)
  set(_bp_sha_pfr 401385c240027423acbb1eb6dea2abe0043db5aa)
  set(_bp_sha_predef e1211a4ca467bb6512e99025772ca25afa8d6159)
  set(_bp_sha_preprocessor cd1b1bd03900b68505822cfa25cb16851bd6caf1)
  set(_bp_sha_scope c979d5e11b43cc36d5d5b8883e5b8a243478794f)
  set(_bp_sha_static_string 2ff9d3535e853f4913e85e7fea28f84b04ea5d81)
  set(_bp_sha_throw_exception 0924b53b40d1da33301f94fb97518f5a7df31e9b)
  set(_bp_sha_type_traits e6275ccf01c9cf8775ef0cb6188bd58f3b167a0f)
  set(_bp_sha_unordered 636164f1357cf217374313820a457c31b50fcfc7)
  set(_bp_sha_utility 8679ac0f1f769fa8d705a1d2329afb5fb6a1eaf2)
  set(_bp_sha_uuid 9c5f195bcdb5d85a857831e22bd182589c3374d0)

  if(NOT DEFINED _bp_sha_${module})
    message(FATAL_ERROR "BoostPack: unknown Boost module '${module}' (see supported modules in README.md)")
  endif()
  set(out_deps_var "_bp_deps_${module}")
  set(out_sha_var "_bp_sha_${module}")
  set(${out_deps} "${${out_deps_var}}" PARENT_SCOPE)
  set(${out_sha} "${${out_sha_var}}" PARENT_SCOPE)
endfunction()

function(boostpack_add)
  cmake_parse_arguments(BP "" "VERSION" "COMPONENTS" ${ARGN})
  if(BP_UNPARSED_ARGUMENTS OR BP_KEYWORDS_MISSING_VALUES)
    message(FATAL_ERROR "BoostPack: invalid arguments to boostpack_add()")
  endif()
  if(NOT BP_VERSION OR NOT BP_COMPONENTS)
    message(FATAL_ERROR "BoostPack: boostpack_add(VERSION <version> COMPONENTS <names...>) is required")
  endif()

  get_property(previous_version GLOBAL PROPERTY BOOSTPACK_VERSION)
  if(previous_version AND NOT previous_version STREQUAL BP_VERSION)
    message(FATAL_ERROR "BoostPack: Boost ${previous_version} is already loaded; cannot also load ${BP_VERSION}")
  endif()
  if(NOT BP_VERSION STREQUAL "1.92.0")
    message(FATAL_ERROR "BoostPack v0.1.0 only supports Boost 1.92.0 (requested: ${BP_VERSION})")
  endif()

  # Calculate the transitive module closure. Fail before downloading anything
  # if the requested graph contains an unsupported component.
  set(queue ${BP_COMPONENTS})
  set(required "")
  while(queue)
    list(POP_FRONT queue module)
    if(module IN_LIST required)
      continue()
    endif()
    _boostpack_metadata("${module}" deps sha)
    list(APPEND required "${module}")
    list(APPEND queue ${deps})
  endwhile()

  get_property(loaded GLOBAL PROPERTY BOOSTPACK_MODULES)
  set(pending ${required})
  set(ordered "")
  while(pending)
    set(progress FALSE)
    foreach(module IN LISTS pending)
      _boostpack_metadata("${module}" deps sha)
      set(ready TRUE)
      foreach(dep IN LISTS deps)
        if(NOT dep IN_LIST ordered AND NOT dep IN_LIST loaded)
          set(ready FALSE)
          break()
        endif()
      endforeach()
      if(ready)
        list(APPEND ordered "${module}")
        list(REMOVE_ITEM pending "${module}")
        set(progress TRUE)
      endif()
    endforeach()
    if(NOT progress)
      message(FATAL_ERROR "BoostPack: dependency cycle in ${pending}")
    endif()
  endwhile()

  # Reject namespace collisions instead of silently combining incompatible
  # system Boost targets with a source-built subset.
  foreach(module IN LISTS ordered)
    if(TARGET Boost::${module} AND NOT module IN_LIST loaded)
      message(FATAL_ERROR "BoostPack: Boost::${module} already exists outside BoostPack")
    endif()
  endforeach()

  if(BOOSTPACK_CACHE_DIR)
    get_filename_component(cache_dir "${BOOSTPACK_CACHE_DIR}" ABSOLUTE BASE_DIR "${CMAKE_BINARY_DIR}")
    set(FETCHCONTENT_BASE_DIR "${cache_dir}/boost-${BP_VERSION}")
  endif()
  if(BOOSTPACK_OFFLINE)
    set(FETCHCONTENT_FULLY_DISCONNECTED ON)
  endif()
  set(BUILD_TESTING OFF)
  set(BOOST_SUPERPROJECT_VERSION "${BP_VERSION}")

  set(extract_options "")
  if(CMAKE_VERSION VERSION_GREATER_EQUAL 3.24)
    list(APPEND extract_options DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
  endif()

  foreach(module IN LISTS ordered)
    if(module IN_LIST loaded)
      continue()
    endif()
    _boostpack_metadata("${module}" deps sha)
    set(content "boostpack_${module}")
    FetchContent_Declare(${content}
      URL "https://github.com/boostorg/${module}/archive/${sha}.tar.gz"
      SOURCE_SUBDIR "_boostpack_no_autoconfigure"
      ${extract_options}
    )
    FetchContent_MakeAvailable(${content})
    FetchContent_GetProperties(${content} SOURCE_DIR source_dir BINARY_DIR binary_dir)
    if(NOT EXISTS "${source_dir}/CMakeLists.txt")
      message(FATAL_ERROR "BoostPack: source for '${module}' is missing at '${source_dir}'. Disable BOOSTPACK_OFFLINE or populate the cache.")
    endif()
    add_subdirectory("${source_dir}" "${binary_dir}" EXCLUDE_FROM_ALL)
    if(NOT TARGET Boost::${module})
      message(FATAL_ERROR "BoostPack: upstream ${module} did not define Boost::${module}")
    endif()
    list(APPEND loaded "${module}")
    set_property(GLOBAL PROPERTY BOOSTPACK_MODULES "${loaded}")
    message(STATUS "BoostPack: added Boost::${module}")
  endforeach()
  set_property(GLOBAL PROPERTY BOOSTPACK_VERSION "${BP_VERSION}")
endfunction()
